NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khidmatai
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Cloudinary signed uploads. Keep API_SECRET on the backend only.
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Optional free GeoNames account for future location synchronization jobs.
GEONAMES_USERNAME=replace-with-geonames-username
